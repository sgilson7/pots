 "trees": {
  "hero": {
   "rules": [
    {
     "if": [
      "dead"
     ],
     "do": "wait",
     "note": "dead: shop from the fountain"
    },
    {
     "if": [
      "has_points"
     ],
     "do": "learn",
     "note": "spend a skill point"
    },
    {
     "if": [
      {
       "needs_fountain": 25
      }
     ],
     "do": "go_home",
     "interrupt": true,
     "note": "low on health: go to the fountain"
    },
    {
     "if": [
      "at_fountain",
      {
       "hp_below": 90
      }
     ],
     "do": "stay",
     "note": "heal up"
    },
    {
     "if": [
      {
       "hp_below": 70
      },
      "can_heal"
     ],
     "do": "potion",
     "note": "use a salve, a tango or a clarity"
    },
    {
     "if": [
      {
       "not": {
        "mana_above": 35
       }
      },
      "can_mana"
     ],
     "do": "potion",
     "note": "use a clarity when low on mana"
    },
    {
     "if": [
      "can_buy"
     ],
     "do": "buy",
     "note": "buy the next item of the build"
    },
    {
     "if": [
      "tower_targets_me"
     ],
     "do": "retreat",
     "interrupt": true,
     "note": "a tower is hitting me"
    },
    {
     "if": [
      {
       "outnumbered": 1000
      },
      {
       "hp_below": 60
      }
     ],
     "do": "retreat",
     "note": "outnumbered"
    },
    {
     "if": [
      "ability_ready",
      {
       "enemy_hero_near": 900
      }
     ],
     "do": "cast",
     "note": "use an ability on an enemy hero"
    },
    {
     "if": [
      {
       "enemy_hero_weak": [
        35,
        900
       ]
      },
      {
       "not": "under_enemy_tower"
      }
     ],
     "do": "fight",
     "note": "finish a weak enemy hero"
    },
    {
     "if": [
      {
       "enemies_near": [
        1,
        700
       ]
      },
      {
       "allies_near": [
        1,
        900
       ]
      },
      {
       "not": "under_enemy_tower"
      },
      {
       "chance": 30
      }
     ],
     "do": "fight",
     "note": "fight with an ally"
    },
    {
     "if": [
      {
       "skill": "runes"
      },
      {
       "chance": 10
      }
     ],
     "do": "rune",
     "note": "take a rune"
    },
    {
     "if": [
      {
       "after": 20
      },
      {
       "not": {
        "enemy_creeps_near": 1500
       }
      },
      {
       "chance": 30
      }
     ],
     "do": "push",
     "note": "push the lane late"
    },
    {
     "if": [
      {
       "enemy_hero_near": 700
      },
      {
       "chance": 20
      }
     ],
     "do": "harass",
     "note": "harass in lane"
    },
    {
     "if": [
      {
       "after": 8
      },
      {
       "not": {
        "enemy_hero_near": 1000
       }
      },
      {
       "hp_above": 50
      }
     ],
     "do": "siege",
     "note": "help the creeps take a building"
    },
    {
     "do": "farm",
     "note": "last-hit and deny in lane"
    }
   ]
  }
 },
